@model DiscussionBoard.Models.DiscussionThread
<article class="card mb-3">
    <div class="card-body">
        <h2 class="h5"><a asp-page="/Discussions/Details" asp-route-id="@Model.ForumId">@Model.Title</a></h2>
        <p>@Model.Content</p>
        <p>By @Model.ApplicationUser</p>
        <p>On @Model.CreatedAt.ToString()</p>
    </div>
</article>



