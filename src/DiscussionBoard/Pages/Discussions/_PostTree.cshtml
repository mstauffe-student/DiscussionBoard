@using DiscussionBoard
@model DiscussionBoard.Services.PostTreeBuilder.Node
@using DiscussionBoard.Authorization
@using Microsoft.AspNetCore.Authorization
@inject IApplicationAuthorizationService AuthorizedService

@{
    //TODO maybe make a helper class for default values so stuff like this isn't repeated?
    string DefaultName = "Unconfigured User";
    string DefaultAvatar = "default.svg";
    string AvatarUrl = ".svg";
}

<article class="border rounded p-3 mb-3" aria-label="Post" data-post-id="@Model.Post.Id">
    <p class="mb-1">@Model.Post.Content</p>
    <!--I'm sorry. This was the only way I could thing of and it works. -->
    @if (string.IsNullOrEmpty(Model.Post.ApplicationUser?.DisplayName) &&  string.IsNullOrEmpty(Model.Post.ApplicationUser?.AvatarId))
    {
        <!--If the display name and avatar is empty, gives the post a default name and avatar -->
        <small class="text-primary"><img src="/images/avatars/@DefaultAvatar" alt="default avatar"
                                         width="25px" height="25px"/> @DefaultName</small>
    }
    @if (string.IsNullOrEmpty(Model.Post.ApplicationUser?.AvatarId))
    {
        <!--If the avatar is empty, gives the post a default avatar -->
        <small class="text-primary"><img src="/images/avatars/@DefaultAvatar" alt="default avatar"
                                         width="25px" height="25px"/> @Model.Post.ApplicationUser?.DisplayName</small>
    }
    @if (string.IsNullOrEmpty(Model.Post.ApplicationUser?.DisplayName))
    {
        <!--If the display name is empty, gives the post a default name -->
        <small class="text-primary">
            <img src="/images/avatars/@Model.Post.ApplicationUser?.AvatarId@AvatarUrl"
                 alt="@Model.Post.ApplicationUser?.AvatarId avatar" width="25px" height="25px"/> @DefaultName</small>
    }
    else
    {
        <!--If the display name and avatar are not empty, no default values are given -->
        <small class="text-primary">
            <img src="/images/avatars/@Model.Post.ApplicationUser?.AvatarId@AvatarUrl"
                 alt="@Model.Post.ApplicationUser?.AvatarId avatar" width="25px" height="25px"/> @Model.Post.ApplicationUser?.DisplayName
        </small>
    }
    <small class="text-muted">@Model.Post.ApplicationUser?.UserName  — @Model.Post.CreatedAt.ToLocalTime().ToString("g")</small>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <details class="mt-2">
            <summary class="btn btn-sm btn-outline-primary">Reply to this post</summary>
            <form method="post" asp-page-handler="Reply" asp-route-threadId="@Model.Post.DiscussionThreadId" class="mt-2">
                <input type="hidden" name="Input.ParentPostId" value="@Model.Post.Id" />
                <label for="reply-@Model.Post.Id">Your reply</label>
                <textarea id="reply-@Model.Post.Id" name="Input.Content" class="form-control" required maxlength="10000"></textarea>
                <button type="submit" class="btn btn-primary btn-sm mt-2">Post reply</button>
            </form>
        </details>
    }
    @if (await AuthorizedService.CanEditAsync(User, Model.Post))
    {
        <!--Checks if user is allowed to edit a post/reply -->
        <a href= "/Discussion/@Model.Post.DiscussionThread.Id/Post/Edit/@Model.Post.Id">Edit this post</a>
    }
    @* This recursively displays the replies to build the visual hierarchy *@
    @if (Model.Replies.Count > 0)
    {
        <div class="ms-4 mt-3 ps-3 border-start border-3" aria-label="Replies to this post">
            @foreach (var reply in Model.Replies)
            {
                <partial name="/Pages/Discussions/_PostTree.cshtml" model="reply" />
            }
        </div>
    }
</article>
