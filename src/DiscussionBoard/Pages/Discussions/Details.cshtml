@page "/Discussion/{id:int}"
@using DiscussionBoard.Models
@model DiscussionBoard.Pages.Discussions.Details
@{
string AvatarUrl = ".svg";
}
@{
    ViewData["Title"] = "Discussions";
}

@if (string.IsNullOrEmpty(Model.ThreadAuthors.ApplicationUser?.AvatarId))
{
    <!--If the avatar is empty, gives the thread a default avatar -->
    <h1>Discussions for this thread</h1> <img src="/images/avatars/default.svg" alt="default avatar" width="25px" height="25px"/>
}
else
{
    <!--If the avatar isn't empty, gives the thread it's avatar -->
    <h1>Discussions for this thread</h1> <img src="/images/avatars/@Model.ThreadAuthors.ApplicationUser?.AvatarId@AvatarUrl" alt="@Model.ThreadAuthors.ApplicationUser?.AvatarId" width="25px" height="25px"/>
}

<hr/><p>@ViewData["IfEmpty"]</p> <!--Displays a message if there's nothing to show -->
<p class="text-danger">@TempData["ErrorMessage"]</p> <!--Displays a message if there's an error -->

<!--Creates a list of posts with replies (if any) -->
@foreach (var replies in Model.ReplyItems)
{
    <partial name="_PostTree" model="replies"/>
}

<br/><hr/><h4>Create a Post:</h4>
<form method="post" asp-page-handler="Create">
    <label for="content" class="form-label">Your post:</label>
    <input id="content" name="content" type="text" class="form-control" minlength="2" maxlength="5000"/>

    <button type="submit" class="btn btn-primary">Create</button>
</form>

<!--Creates links to go back a page or all the way back to forums -->
<a href= "/Forums/Index">Go back to Forums page</a>
<br/><a href= "javascript:history.back()">Go back to previous page</a>
