@page "/Edit"
@model DiscussionBoard.Pages.Discussions.Edit

@{
    ViewData["Title"] = "Edit a Thread";
}
<h2>Edit a Thread:</h2>
<p class="text-danger">@TempData["ErrorMessage"]</p> <!--Displays a message if there's an error -->

<!--post form to allow user to edit a thread. Includes ThreadName, Title, and Content.
ThreadName is the name of the thread the user wants to change. I figured asking for the thread id
wouldn't be a good idea for security, and an average user is unlikely to know that.-->
<form method="post">
    <label asp-for="Input.ThreadName" class="form-label">Title of thread to be changed:</label>
    <input asp-for="Input.ThreadName" name="Input.ThreadName" type="text" class="form-control" minlength="2" maxlength="50"/>

    <label asp-for="Input.Title" class="form-label">New title:</label>
    <input asp-for="Input.Title" name="Input.Title" type="text" class="form-control" minlength="2" maxlength="50"/>

    <label asp-for="Input.Content" class="form-label">New content:</label>
    <input asp-for="Input.Content" name="Input.Content" type="text" class="form-control" maxlength="5000"/>

    <button type="submit" class="btn btn-primary">Create</button>
</form>

<!--Creates links to go back a page or all the way back to forums -->
<br/><a href= "/Forums/Index">Go back to Forums page</a>
