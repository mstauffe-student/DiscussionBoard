@page "/Discussion/{threadId}/Post/Edit/{postId}"
@model DiscussionBoard.Pages.Discussions.EditPostModel

@{
    ViewData["Title"] = "Edit a post";
}
<h2>Edit this Post:</h2>
<p class="text-danger">@TempData["ErrorMessage"]</p> <!--Displays a message if there's an error -->

<!--post form to allow user to edit a thread. Includes ThreadName, Title, and Content.
ThreadName is the name of the thread the user wants to change. I figured asking for the thread id
wouldn't be a good idea for security, and an average user is unlikely to know that.-->
<form method="post">
    <label asp-for="Input.Content" class="form-label">Change the content:</label>
    <input asp-for="Input.Content" name="Input.Content" type="text" class="form-control" minlength="1" maxlength="10000"/>
    <br/><button type="submit" class="btn btn-primary">Submit</button>
</form>

<!--Creates links to go back a page or all the way back to forums -->
<br/><a href= "/Forums">Go back to Forums page</a>
<br/><a href= "javascript:history.back()">Go back to previous page</a>


