{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=Data/discussion.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Formatting.Compact",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
              {
                "Name": "Console"
              },
              {
                "Name": "File",
                "Args": {
                  "path": "Logs/discussionboard-.json",
                  "rollingInterval": "Day",
                  "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
                }
              }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}
